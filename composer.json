{
    "name": "akirk/family-wiki",
    "description": "Keep your family history in a wiki app hosted on WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "akirk/wp-app": "^2.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Family_Wiki\\": "src/"
        }
    },
    "version": "2.0.0",
    "authors": [
        {
            "name": "Alex Kirk"
        }
    ],
    "scripts": {
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "test": [
            "@lint",
            "php tests/upgrade.php",
            "php tests/relatives.php",
            "@phpcs"
        ]
    },
    "config": {
        "autoloader-suffix": "familywiki",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
